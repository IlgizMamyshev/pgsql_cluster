# Please specify the ip addresses and connection settings for your environment

# "postgresql_exists='true'" if PostgreSQL is already exists and running

# etcd nodes (<hostname|FQDN|IPv4> [ansible_host=<IPv4>]) (set ansible_host only if hostname not resolved, or use /etc/hosts)
[etcd_cluster]  # recommendation: 3 or 5-7 nodes
MLK-DCS-ETCD-N1.dba.lab #ansible_host=192.168.10.201
SVO-DCS-ETCD-N2.dba.lab #ansible_host=192.168.10.202
MSK-DCS-ETCD-N3.dba.lab #ansible_host=192.168.10.203

# PostgreSQL nodes (<hostname|FQDN|IPv4> postgresql_exists='<false|true>')
[master]
MLK-DB-PGPRO-N7.dba.lab postgresql_exists='false'

[replica]
MLK-DB-PGPRO-N8.dba.lab postgresql_exists='false'
SVO-DB-PGPRO-N9.dba.lab postgresql_exists='false'

[postgres_cluster:children]
master
replica

# Connection settings
[all:vars]
ansible_connection='ssh'
ansible_ssh_port='22'
ansible_user='pgadmin'
ansible_ssh_pass='P@ssw0rd'  # "sshpass" package is required for use "ansible_ssh_pass"
